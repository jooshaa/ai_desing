NODE_ENV=development
PORT=3001

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=imora
POSTGRES_PASSWORD=imora
POSTGRES_DB=imora

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=imora
S3_ACCESS_KEY=imora
S3_SECRET_KEY=imora-secret
S3_FORCE_PATH_STYLE=true

SMS_PROVIDER=stub
SMS_API_KEY=

# --- AI design (design module) ---
# stub = free, offline, no key. Every other value needs AI_API_KEY.
# cloudflare = FLUX.2 klein, free 10k Neurons/day, no card. Also set the account id.
AI_PROVIDER=stub
AI_MODEL=
AI_API_KEY=
AI_CLOUDFLARE_ACCOUNT_ID=
AI_VARIANT_COUNT=3
# Free-tier ceiling on Cloudflare klein is ~39 requests/day; 35 leaves headroom.
AI_DAILY_LIMIT=35
AI_USER_DAILY_LIMIT=5
# Hard money cap per day in USD. -1 disables. Irrelevant on a free provider.
AI_DAILY_BUDGET_USD=1
AI_TZ_OFFSET_HOURS=5
# inline runs generation in-process (no Redis). Set to bull in production.
DESIGN_QUEUE_DRIVER=inline
# Dev-only stand-in identity until core's JWT guard lands. Never set on a server.
DESIGN_DEV_USER_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=

# Next.js public API (web-user / web-store)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
